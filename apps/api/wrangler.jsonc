{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // One Worker serves the PWA (static assets), the JSON API under /api/* and
  // the hourly Garmin sync. Cloudflare Access protects the whole hostname and
  // the Worker verifies the Access JWT itself on every /api request.
  "name": "garmin-personal-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // No per-version preview hostnames: they would sit outside the Access app.
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "garmin-coach-db",
      // Set after `wrangler d1 create garmin-coach-db` (see docs/DEPLOYMENT.md).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly Garmin sync, off the top of the hour.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    // "mock" until the live Garmin Personal API is connected.
    "GARMIN_MODE": "mock",
    // normal | well_rested | fatigued | illness | calibrating  (mock mode only)
    "MOCK_SCENARIO": "normal"
    // ACCESS_TEAM_DOMAIN, ACCESS_AUD and OWNER_EMAIL are Worker secrets, set at
    // deploy time, so no account details or personal data live in the repo.
  },
  "observability": {
    "enabled": true
  }
}
